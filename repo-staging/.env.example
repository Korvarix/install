# korvarix-cluster — .env reference
# The setup wizard (menu 1) generates this file interactively at
# /etc/korvarix-cluster/korvarix.env. This .env.example is the documented
# reference for scripted/CI use:  cp .env.example korvarix.env
#
# Only the keys relevant to a box's ROLE are required on that box.
# Roles: vpn (interface box) | master (first node) | node (RAM donor) | frontend

# ==============================================================================
# Station (bootstrap-only; can also be passed as env vars to the script)
# ==============================================================================

# Module repo (raw GitHub, modules/ subfolder of Korvarix/install).
# Manual updates via: korvarix-cluster.sh update
KCV_REPO_URL=https://raw.githubusercontent.com/Korvarix/install/main/modules

# ==============================================================================
# Identity (every machine)
# ==============================================================================

# This machine's name (wizard default: hostname). The peer config on the
# interface box is issued per NODE_NAME.
NODE_NAME=

# ==============================================================================
# VPN / WireGuard (roles: all)
# ==============================================================================

# Public IP of the INTERFACE BOX (peers reach udp/51820 there).
VPN_PUBLIC_IP=

# VPN subnet (defaults are fine)
VPN_NET=10.8.0.0
VPN_MASK=24

# WireGuard listen port (interface box only)
WG_PORT=51820

# ==============================================================================
# Inference (roles: master, node)
# ==============================================================================

# Where gguf models live on the MASTER (local disk - models never live on
# a shared mount; donors need no storage).
MODELS_DIR=/data/models

# gguf FILENAME inside MODELS_DIR that llama-server loads (role: master).
MODEL_FILE=

# Comma-separated ip:port of donor rpc-servers for merged-RAM models.
# EMPTY day one (master solo). Add donors with: llama add-peer 10.8.0.x
RPC_PEERS=

# rpc port between nodes / public-facing llama-server port.
RPC_PORT=50052
LLAMA_PORT=8080

# llama-server bind address. Default: NODE_VPN_IP (reachable by the frontend
# over the VPN). NEVER a public IP.
# LLAMA_BIND=10.8.0.11

# llama-server context size (RAM scales with this) and optional thread count.
N_CTX=8192
# N_THREADS=14

# llama.cpp version pin (ALL nodes should build the same ref). Empty = HEAD.
LLAMA_CPP_REF=

# ==============================================================================
# Ollama: sandboxed serving, allowlist, daily patches, request policy (menu 5)
# ==============================================================================

# THE MODELS CLIENTS MAY CALL. Space-separated ollama model names.
# Everything else is refused at the gate (model_not_allowed) and pruned daily.
MODELS_ALLOWLIST=qwen2.5:7b llama3.1:8b

# Daily patch job (05:23 + jitter via cron): re-pulls allowlisted models so
# quant/patch updates land automatically, then prunes non-allowlisted strays.
# "1" = cron installed with menu 7 -> ollama daily cron. Manual anytime:
#   korvarix-cluster.sh ollama daily
OLLAMA_DAILY_PULL=1

# Sandbox: dedicated unprivileged user + systemd hardening (NoNewPrivileges,
# ProtectSystem=strict, PrivateTmp, ...). Keep at 1 for a public endpoint.
OLLAMA_SANDBOX=1

# Capacity budget (protects RAM on the serving node - the master also hosts
# merged-RAM inference; big models + loaded ollama models compete for RAM):
OLLAMA_PORT=11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED=2
OLLAMA_KEEP_ALIVE=10m

# Where the daemon binds. 127.0.0.1 = local only (frontend must run on THIS
# node). Set to THIS node's VPN IP (NODE_VPN_IP, e.g. 10.8.0.11) so the
# frontend box's Open WebUI can reach the one shared daemon over the VPN.
# NEVER a public IP - the VPN is the reachability boundary.
OLLAMA_BIND=127.0.0.1

# ---- request policy (baked into korvarix-policy.json, enforced by the gate) --
# Parameters are CLAMPS: the gate rewrites client-supplied values DOWN to these
# bounds. Defaults are a sane public-endpoint posture; tighten freely.

# Rate limits (sliding 60s windows). RPM_KEY tuned for long coding sessions;
# unlimited plans are bounded by these + in-flight caps, not token budgets.
POLICY_RPM_IP=10
POLICY_RPM_KEY=60
POLICY_INFLIGHT_IP=2

# Sampling + prompt clamps (coding-first defaults: 32k ctx, 8k out)
POLICY_MAX_CTX=32768
POLICY_MAX_OUT=8192
POLICY_MAX_PROMPT_CHARS=128000
POLICY_TEMP_MAX=1.0
POLICY_TOPP_MAX=1.0

# Key-mint budget per source IP per day (slows key-farming abuse)
POLICY_KEYS_PER_IP_DAY=5

# Web lookup (internet search tools): OFF by default. When true, the gate
# forwards client tool/web-search fields to the model. Keep false unless you
# also accept the legal exposure of the model fetching third-party content.
POLICY_WEB_LOOKUP=false

# Safety filter: refuses CSAM / weapons / violent-extremism solicitations at
# the gate, before any model sees them. Keep ON for a public service.
POLICY_SAFETY_FILTER=true

# When true, client-supplied "system" messages are dropped (locks the model's
# persona to what YOU configure server-side).
POLICY_LOCK_SYSTEM_PROMPT=false

# Where to push the built policy (defaults to FRONTEND_VPN_IP; set by the
# frontend wizard - NEVER the master, the gate does not live there)
# POLICY_PUSH_HOST=10.8.0.12

# ==============================================================================
# Hugging Face tracker (menu 13; run on the OLLAMA serving node)
# ==============================================================================

# hf.co/<repo>:<quant> models the daily hfmodels job keeps fresh. Empty by
# default; populated automatically when you adopt a model via
#   korvarix-cluster.sh hfmodels add <hf-repo-id>
# HF_TRACKED_MODELS=

# Daily job auto-adopts the newest trending model per developer company that
# the node does not serve yet (0 = only refresh tracked models)
HF_AUTO_DISCOVER=1

# Max NEW models adopted per daily run (protects disk from a trending storm)
HF_MAX_MODELS=1

# Per-model download budget in GB; quants above this are never adopted.
# Keeps a trending 763B/2.8T monster off the node. Fits one 27B Q4_K_M.
HF_MAX_MODEL_GB=24

# Keep this much disk free AFTER a pull, or the model is skipped
HF_MIN_FREE_GB=30

# Quant preference order - first chain entry with a file within budget wins
HF_QUANT_CHAIN=Q4_K_M Q4_K_S Q4_0 Q3_K_M Q8_0

# Orgs to never auto-adopt (space-separated)
HF_ORG_BLOCKLIST=jinaai

# How deep into the HF trending board to scan
HF_DISCOVER_LIMIT=100

# ==============================================================================
# Monitoring (roles: all)
# ==============================================================================

# Optional Discord/Slack-style webhook - receives health flips as JSON.
HEALTH_WEBHOOK=

# Alert thresholds (percent).
DISK_ALERT_PCT=85
MEM_ALERT_PCT=90

# ==============================================================================
# Backup (roles: master, node, frontend)
# ==============================================================================

# Off-cluster restic target. Examples:
#   /mnt/backup                      (local disk of the interface box, mounted)
#   ssh://user@backup-host:22/backup (remote ssh - needs key auth)
#   rest:https://user:pass@host:8000 (rest-server)
# NEVER a path on this cluster itself.
# The frontend role additionally snapshots the Open WebUI data volume
# (korvarix-llm-data: webui.db + uploads) + korvarix-llm/.env + /etc/korvarix-llm.
BACKUP_TARGET=

# What to snapshot (space-separated). Defaults to the korvarix config dirs.
BACKUP_ROOTS=/etc/korvarix-cluster /var/lib/korvarix-cluster/data

# Nightly snapshots retained.
BACKUP_KEEP=7

# ==============================================================================
# korvarix-llm frontend module (menu 11; run on the FRONTEND box)
# ==============================================================================

# Where the korvarix-llm folder (install.sh, gate/, lib/) is cloned.
LLM_FRONTEND_DIR=/opt/korvarix-llm

# Explicit endpoint overrides for the frontend's .env (leave empty to
# auto-wire from MASTER_VPN_IP + LLAMA_PORT / OLLAMA_PORT).
# KLM_MASTER_ENDPOINT=http://10.8.0.11:8080/v1
# KLM_OLLAMA_ENDPOINT=http://10.8.0.11:11434