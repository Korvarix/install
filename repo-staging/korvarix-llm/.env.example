# korvarix-llm — .env reference
# Copy to .env and adjust:  cp .env.example .env
# (./install.sh also generates a working .env on first run; existing .env is
#  never overwritten — edit it and re-run ./install.sh to apply)
#
# Section map:
#   1. Open WebUI container      — image, ports, secrets, admin, signup
#   2. Model backends            — Ollama / OpenAI-compatible
#   3. nginx proxy               — public hostname + Let's Encrypt
#   4. korvarix SSO gate         — the normal access wall
#   5. Emergency bypass          — the kill switch (GATE_BYPASS=1)
#   6. Open WebUI integration    — avatars, trusted headers, sign-out
#   7. Gate runtime (optional)   — paths, bind, tracing (defaults fine)

# ==============================================================================
# 1. Open WebUI container (./install.sh)
# ==============================================================================

# Image tag: "main" = stable frontend; ":cuda" adds GPU for local inference
# (irrelevant on this frontend-only box; models come from the LLM machine).
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Loopback port the reverse proxy points at. NEVER expose this publicly —
# trusted-header auth is only safe behind the gate.
WEBUI_PORT=8210

# Session signing key. REQUIRED (Open WebUI refuses to boot without it).
# ALSO the gate's session-cookie signing key (they must stay in sync).
# Generate:  openssl rand -hex 32
# install.sh generates one automatically on first install.
WEBUI_SECRET_KEY=

# Open WebUI's OWN bootstrap admin (created on FIRST boot only).
# Dual duty: in EMERGENCY BYPASS mode the gate uses WEBUI_ADMIN_EMAIL as the
# account it signs in server-side (see section 5). The gate NEVER uses the
# password for auth — but WEBUI_ADMIN_PASSWORD must be NON-EMPTY for the
# bypass magic login to arm (any filler value works if the admin already
# exists and the password is unknown).
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Signup stays closed; accounts are created via korvarix SSO (gate) or the admin.
ENABLE_SIGNUP=False
ENABLE_LOGIN_FORM=True

# UI display name. QUOTED on purpose: .env is sourced as shell, and an
# unquoted space ("WEBUI_NAME=Korvarix AI") breaks sourcing. install.sh passes
# the shell-parsed value with an explicit -e so the container never sees the
# literal quote characters.
WEBUI_NAME="Korvarix AI"

# ==============================================================================
# 2. Model backends (fill in when the LLM machine is ready)
# ==============================================================================

# The separate LLM machine running Ollama, e.g. http://10.0.0.5:11434
# (or an https endpoint). Empty = frontend-only, no models.
# MULTIPLE MODELS from one daemon: point at the cluster master's VPN IP and
# Open WebUI lists every model in its MODELS_ALLOWLIST in a single dropdown:
#   OLLAMA_BASE_URL=http://10.8.0.11:11434
OLLAMA_BASE_URL=

# INFERENCE POOL: multiple Ollama worker nodes (master + slaves), comma-
# separated. When set, Open WebUI uses this INSTEAD of OLLAMA_BASE_URL and
# every listed node's models appear in the picker (duplicates are normal -
# one entry per node). Adding a slave:
#   1. append http://<SLAVE_IP>:11434 to this list
#   2. re-run ./install.sh (recreates the container with the new env)
#   3. ./install.sh ollama-check  (every node must answer before users hit it)
#   OLLAMA_BASE_URLS=http://10.8.0.14:11434,http://10.8.0.15:11434
OLLAMA_BASE_URLS=

# Optional: any OpenAI-compatible endpoint as an alternative/extra backend.
# THIS is where an ollama.com cloud key goes for ollama's OpenAI-compatible
# API (models then appear in the OWUI picker automatically):
#   OPENAI_API_BASE_URL=https://ollama.com/v1
#   OPENAI_API_KEY=<your ollama key>
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# ==============================================================================
# 3. nginx proxy (./install.sh nginx)
# ==============================================================================

# Public hostname. DNS must point at this machine; port 80 must be reachable
# for the Let's Encrypt HTTP-01 challenge.
LLM_DOMAIN=llm.korvarix.com

# Let's Encrypt expiry-notice address.
LE_EMAIL=admin@korvarix.com

# korvarix branding (./install.sh applies it automatically)
# ------------------------------------------------------------------------------
# The container gets theme/custom.css mounted as /static/custom.css and the
# generated korvarix PNG/ICO set over the stock /static/{logo,favicon,splash}
# assets. Regenerate the asset set after editing theme/korvarix-logo.svg:
#   node scripts/make-branding.mjs theme/korvarix-logo.svg theme/assets
# then re-run ./install.sh.

# ==============================================================================
# 4. korvarix SSO gate (./install.sh gate) — written by gate_env, safe to pre-fill
# ==============================================================================

# Shared secret with korvarix-base. The base site's /api/sso/llm/redeem only
# accepts callers presenting this key. MUST be the SAME value in both .env files.
# Generate:  openssl rand -hex 32
# (install.sh generates one when you run ./install.sh gate)
LLM_SSO_KEY=

# Port the gate listens on (nginx proxies here instead of WEBUI_PORT).
GATE_PORT=8211

# How the gate reaches the Open WebUI container: the docker network alias.
# (gate and open-webui share the korvarix-llm-net docker network)
WEBUI_HOST=open-webui

# The port Open WebUI LISTENS on INSIDE the container (8080). This is NOT
# WEBUI_PORT - that is only the host-published mapping (127.0.0.1:8210:8080).
# Container-to-container traffic must use the internal port.
WEBUI_INTERNAL_PORT=8080

# Gate session lifetime after a korvarix sign-in (seconds). The session itself
# is long-lived; PANEL ACCESS is governed by the subscription re-check
# (GATE_ENTITLEMENT_CHECK_S) - a lapsed plan locks out at the next page load.
GATE_SESSION_TTL_S=2592000

# How often (seconds) the gate re-verifies LLM entitlement with korvarix.com
# on document loads. 300 = 5 minutes. Lower = tighter lockout after a lapse.
GATE_ENTITLEMENT_CHECK_S=300

# Public-endpoint capacity clamps (also settable in the station's
# korvarix-policy.json `limits` block - the pushed policy wins):
#   max_in_flight_per_user = concurrent completions per account (instances)
#   max_threads            = Ollama options.num_thread ceiling per request
# These built-in defaults hold when the policy omits them.
#   (defaults live in gate/gate.js: 2 instances, 8 threads)

# ==============================================================================
# 5. EMERGENCY BYPASS (./install.sh gate-off / gate-on)
# ==============================================================================
# The kill switch: GATE_BYPASS=true makes the gate skip the SSO/entitlement
# wall and proxy straight to Open WebUI (no trusted headers; browser cookies
# pass through). Use ONLY while korvarix.com is down - the panel opens up to
# anyone who can reach Open WebUI's login surface.

# true = wall down. Toggle with:
#   ./install.sh gate-off   (bypass ON - wall down)
#   ./install.sh gate-on    (bypass OFF - wall restored)
GATE_BYPASS=false

# While GATE_BYPASS=1, POST /api/v1/auths/signin is answered by the GATE
# itself (OWUI's own form can never work in this mode: it runs trusted-header
# auth, and SSO-provisioned accounts have no password). The gate signs in
# WEBUI_ADMIN_EMAIL server-side ONLY when the submitted credentials match
# BOTH values below (timing-safe). Leave GATE_BYPASS_EMAIL empty to keep the
# login form dead in bypass mode.
GATE_BYPASS_EMAIL=emergency@korvarix.com
GATE_BYPASS_PASSWORD=
# ^ REQUIRED for the magic login: a long random secret ONLY you know.
#   openssl rand -hex 24
#   Anyone without it gets 401. NEVER reuse the real admin password here.

# In bypass mode the gate also rewrites the sign-out response so the SPA does
# NOT navigate to WEBUI_AUTH_SIGNOUT_REDIRECT_URL (korvarix.com may be down) -
# sign-out lands on the panel's own /auth instead. No knob needed.

# ==============================================================================
# 6. Open WebUI integration (avatar sync; trusted-header SSO)
# ==============================================================================

# Open WebUI API key (sk-...) minted by your admin user INSIDE Open WebUI:
#   Settings -> Account -> API Keys -> create
# The gate uses it to sync each korvarix user's avatar into their OWUI
# profile (gravatar is never used). NOT the admin password. NEVER a URL.
OPEN_WEBUI_API_KEY=

# Optional CDN fallback for avatars: when the base site's SSO response carries
# no avatarUrl (CDN off there / older base build), the gate constructs the
# CDN path itself: CDN_BASE_URL + /f/avatars/<userId> (the base site's shape).
# Leave empty unless you need the fallback - the base site normally embeds
# the full URL in the SSO response already.
# CDN_BASE_URL=https://cdn.korvarix.com

# true  = OWUI 302-forwards <img> requests to the korvarix CDN avatar URL
# false = gate embeds the avatar bytes as a data: URI instead (use when the
#         browser shouldn't talk to the CDN directly)
ENABLE_PROFILE_IMAGE_URL_FORWARDING=true

# Trusted-header SSO: Open WebUI signs users in from these request headers.
# The gate injects them; they MUST only ever be reachable through the gate.
# (install.sh uncomments these automatically when the gate is installed)
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=X-Korvarix-Email
WEBUI_AUTH_TRUSTED_NAME_HEADER=X-Korvarix-Name

# After signing out of Open WebUI, send the user back to korvarix.com.
# (Bypass mode overrides this locally - see section 5.)
WEBUI_AUTH_SIGNOUT_REDIRECT_URL=https://korvarix.com/account

# ==============================================================================
# 7. Gate runtime (optional - defaults are already correct for containers)
# ==============================================================================

# Bind address: 127.0.0.1 on the host; the containerized gate runs with
# GATE_BIND=0.0.0.0 injected by install.sh (the port stays loopback-published).
# GATE_BIND=127.0.0.1

# 1 = log every proxied request (docker logs). Default: only non-2xx + repairs.
# GATE_TRACE=1

# Policy + usage-log paths (station-pushed policy, checksum-verified).
# Containerized runs mount these host paths; host runs use the real paths.
# KORVARIX_POLICY_PATH=/etc/korvarix-llm/korvarix-policy.json
# KORVARIX_USAGE_LOG=/var/log/korvarix/llm-usage.jsonl

# Public/panel URLs the gate builds redirects with (korvarix.com SSO launch,
# sign-in failures). Change only if the domains move.
# SITE_URL=https://korvarix.com
# LLM_PUBLIC_URL=https://llm.korvarix.com