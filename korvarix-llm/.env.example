# korvarix-llm — .env reference
# Copy to .env and adjust:  cp .env.example .env
# (./install.sh also generates a working .env on first run; existing .env is
#  never overwritten — edit it and re-run ./install.sh to apply)

# ==============================================================================
# Open WebUI container (./install.sh)
# ==============================================================================

# Image tag: "main" = stable frontend; ":cuda" adds GPU for local inference
# (irrelevant on this frontend-only box; models come from the LLM machine).
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# Loopback port the reverse proxy points at. NEVER expose this publicly —
# trusted-header auth is only safe behind the gate.
WEBUI_PORT=8210

# Session signing key. REQUIRED (Open WebUI refuses to boot without it).
# Generate:  openssl rand -hex 32
# install.sh generates one automatically on first install.
WEBUI_SECRET_KEY=

# Open WebUI's OWN bootstrap admin (created on FIRST boot only). This is for
# UI login/admin API-key creation — the gate NEVER uses this password.
# Leave both empty to create the admin in the browser on first visit.
WEBUI_ADMIN_EMAIL=
WEBUI_ADMIN_PASSWORD=

# Signup stays closed; accounts are created via korvarix SSO (gate) or the admin.
ENABLE_SIGNUP=False
ENABLE_LOGIN_FORM=True

# ==============================================================================
# Model backends (fill in when the LLM machine is ready)
# ==============================================================================

# The separate LLM machine running Ollama, e.g. http://10.0.0.5:11434
# (or an https endpoint). Empty = frontend-only, no models (current state).
# MULTIPLE MODELS from one daemon: point at the cluster master's VPN IP and
# Open WebUI lists every model in its MODELS_ALLOWLIST in a single dropdown:
#   OLLAMA_BASE_URL=http://10.8.0.11:11434
OLLAMA_BASE_URL=

# Optional: any OpenAI-compatible endpoint as an alternative/extra backend.
# THIS is where an ollama.com cloud key goes for ollama's OpenAI-compatible
# API (models then appear in the OWUI picker automatically):
#   OPENAI_API_BASE_URL=https://ollama.com/v1
#   OPENAI_API_KEY=<your ollama key>
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# ==============================================================================
# nginx proxy (./install.sh nginx)
# ==============================================================================

# Public hostname. DNS must point at this machine; port 80 must be reachable
# for the Let's Encrypt HTTP-01 challenge.
LLM_DOMAIN=llm.korvarix.com

# Let's Encrypt expiry-notice address.
LE_EMAIL=admin@korvarix.com

# korvarix branding (./install.sh applies it automatically)
# ------------------------------------------------------------------------------
# The container gets theme/custom.css mounted as /static/custom.css and the
# generated korvarix PNG/ICO set over the stock /static/{logo,favicon,splash}
# assets. WEBUI_NAME is appended to .env on first themed install (quoted -
# the .env is sourced as shell: WEBUI_NAME="Korvarix AI").
# Regenerate the asset set after editing theme/korvarix-logo.svg:
#   node scripts/make-branding.mjs theme/korvarix-logo.svg theme/assets
# then re-run ./install.sh.

# ==============================================================================
# External clients (VS Code, curl, python, Chatbox...) - API-key passthrough
# ==============================================================================
# The gate forwards `Authorization: Bearer sk-...` requests on /api/* straight
# to Open WebUI after checking the key owner's subscription. Keys are created
# INSIDE the panel: Settings -> Account -> API Keys. Point clients at:
#   Base URL: https://llm.korvarix.com/api/v1
# No .env changes needed - this is documented on the base-site wiki
# (/wiki/llm-client-setup).

# ==============================================================================
# korvarix SSO gate (./install.sh gate) — written by gate_env, safe to pre-fill
# ==============================================================================

# Shared secret with korvarix-base. The base site's /api/sso/llm/redeem only
# accepts callers presenting this key. MUST be the SAME value in both .env files.
# Generate:  openssl rand -hex 32
# (install.sh generates one when you run ./install.sh gate)
LLM_SSO_KEY=

# Port the gate listens on (nginx proxies here instead of WEBUI_PORT).
GATE_PORT=8211

# How the gate reaches the Open WebUI container: the docker network alias.
# (gate and open-webui share the korvarix-llm-net docker network)
WEBUI_HOST=open-webui

# The port Open WebUI LISTENS on INSIDE the container (8080). This is NOT
# WEBUI_PORT - that is only the host-published mapping (127.0.0.1:8210:8080).
# Container-to-container traffic must use the internal port.
WEBUI_INTERNAL_PORT=8080

# Gate session lifetime after a korvarix sign-in (seconds). The session itself
# is long-lived; PANEL ACCESS is governed by the subscription re-check
# (GATE_ENTITLEMENT_CHECK_S) - a lapsed plan locks out at the next page load.
GATE_SESSION_TTL_S=2592000

# How often (seconds) the gate re-verifies LLM entitlement with korvarix.com
# on document loads. 300 = 5 minutes. Lower = tighter lockout after a lapse.
GATE_ENTITLEMENT_CHECK_S=300

# ==============================================================================
# Open WebUI integration (avatar sync; trusted-header SSO)
# ==============================================================================

# Open WebUI API key (sk-...) minted by your admin user INSIDE Open WebUI:
#   Settings -> Account -> API Keys -> create
# The gate uses it to sync each korvarix user's avatar into their OWUI
# profile (gravatar is never used). NOT the admin password. NEVER a URL.
OPEN_WEBUI_API_KEY=

# Optional CDN fallback for avatars: when the base site's SSO response carries
# no avatarUrl (CDN off there / older base build), the gate constructs the
# CDN path itself: CDN_BASE_URL + /f/avatars/<userId> (the base site's shape).
# Leave empty unless you need the fallback - the base site normally embeds
# the full URL in the SSO response already.
# CDN_BASE_URL=https://cdn.korvarix.com

# true  = OWUI 302-forwards <img> requests to the korvarix CDN avatar URL
# false = gate embeds the avatar bytes as a data: URI instead (use when the
#         browser shouldn't talk to the CDN directly)
ENABLE_PROFILE_IMAGE_URL_FORWARDING=true

# Trusted-header SSO: Open WebUI signs users in from these request headers.
# The gate injects them; they MUST only ever be reachable through the gate.
# (install.sh uncomments these automatically when the gate is installed)
WEBUI_AUTH_TRUSTED_EMAIL_HEADER=X-Korvarix-Email
WEBUI_AUTH_TRUSTED_NAME_HEADER=X-Korvarix-Name

# After signing out of Open WebUI, send the user back to korvarix.com.
WEBUI_AUTH_SIGNOUT_REDIRECT_URL=https://korvarix.com/account